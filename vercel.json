{
  "framework": null,
  "buildCommand": "npm install && npx tailwindcss -i tailwind.css -o tailwind.min.css --minify",
  "outputDirectory": ".",
  "git": {
    "deploymentEnabled": false
  },
  "functions": {
    "api/github.js": { "maxDuration": 30 },
    "api/reviews.js": { "maxDuration": 10 },
    "api/enhance.js": { "maxDuration": 15 },
    "api/facebook.js": { "maxDuration": 60 }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/san-mateo",             "destination": "/dryer-vent-cleaning-san-mateo",             "permanent": true },
    { "source": "/san-francisco",         "destination": "/dryer-vent-cleaning-san-francisco",         "permanent": true },
    { "source": "/san-carlos",            "destination": "/dryer-vent-cleaning-san-carlos",            "permanent": true },
    { "source": "/burlingame",            "destination": "/dryer-vent-cleaning-burlingame",            "permanent": true },
    { "source": "/hillsborough",          "destination": "/dryer-vent-cleaning-hillsborough",          "permanent": true },
    { "source": "/belmont",               "destination": "/dryer-vent-cleaning-belmont",               "permanent": true },
    { "source": "/redwood-city",          "destination": "/dryer-vent-cleaning-redwood-city",          "permanent": true },
    { "source": "/menlo-park",            "destination": "/dryer-vent-cleaning-menlo-park",            "permanent": true },
    { "source": "/half-moon-bay",         "destination": "/dryer-vent-cleaning-half-moon-bay",         "permanent": true },
    { "source": "/south-san-francisco",   "destination": "/dryer-vent-cleaning-south-san-francisco",   "permanent": true },

    { "source": "/dryer-vent-cleaning-san-mateo-ca",            "destination": "/dryer-vent-cleaning-san-mateo",            "permanent": true },
    { "source": "/dryer-vent-cleaning-san-francisco-ca",        "destination": "/dryer-vent-cleaning-san-francisco",        "permanent": true },
    { "source": "/dryer-vent-cleaning-san-carlos-ca",           "destination": "/dryer-vent-cleaning-san-carlos",           "permanent": true },
    { "source": "/dryer-vent-cleaning-burlingame-ca",           "destination": "/dryer-vent-cleaning-burlingame",           "permanent": true },
    { "source": "/dryer-vent-cleaning-hillsborough-ca",         "destination": "/dryer-vent-cleaning-hillsborough",         "permanent": true },
    { "source": "/dryer-vent-cleaning-belmont-ca",              "destination": "/dryer-vent-cleaning-belmont",              "permanent": true },
    { "source": "/dryer-vent-cleaning-redwood-city-ca",         "destination": "/dryer-vent-cleaning-redwood-city",         "permanent": true },
    { "source": "/dryer-vent-cleaning-menlo-park-ca",           "destination": "/dryer-vent-cleaning-menlo-park",           "permanent": true },
    { "source": "/dryer-vent-cleaning-half-moon-bay-ca",        "destination": "/dryer-vent-cleaning-half-moon-bay",        "permanent": true },
    { "source": "/dryer-vent-cleaning-south-san-francisco-ca",  "destination": "/dryer-vent-cleaning-south-san-francisco",  "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options",    "value": "nosniff" },
        { "key": "X-Frame-Options",            "value": "SAMEORIGIN" },
        { "key": "X-XSS-Protection",           "value": "1; mode=block" },
        { "key": "Referrer-Policy",            "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",         "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/reviews",
      "headers": [
        { "key": "Cache-Control", "value": "public, s-maxage=86400, stale-while-revalidate=3600" }
      ]
    }
  ]
}
